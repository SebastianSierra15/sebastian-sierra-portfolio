---
import "../styles/global.css";
import {
  featuredProjects,
  process,
  profile,
  proofPoints,
  secondaryProjects,
  services,
  stackGroups,
  timeline,
} from "../data/portfolio";

const allProjects = [...featuredProjects, ...secondaryProjects];
const seoTitle = "Sebastian Sierra | Full Stack Developer & Frontend Developer";
const seoDescription =
  "Portafolio de Sebastian Sierra, Full Stack Developer con foco en Frontend, React, Next.js, TypeScript, Java y productos digitales para equipos en Colombia y remoto.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: "Full Stack Developer & Frontend Developer",
  email: `mailto:${profile.email}`,
  url: profile.github,
  image: profile.photo,
  address: {
    "@type": "PostalAddress",
    addressCountry: "CO",
  },
  sameAs: [profile.github, profile.linkedin],
  knowsAbout: [
    "React",
    "Next.js",
    "Astro",
    "TypeScript",
    "Java",
    "Node.js",
    "Frontend Development",
    "Full Stack Development",
    "SEO",
  ],
};
---

<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="index, follow" />
    <meta
      name="keywords"
      content="Sebastian Sierra, Full Stack Developer, Frontend Developer, React, Next.js, TypeScript, Java, Colombia"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={profile.photo} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={profile.photo} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("portfolio-theme") || "system";
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const resolved = stored === "system" ? (prefersDark ? "dark" : "light") : stored;
        document.documentElement.dataset.theme = resolved;
        document.documentElement.dataset.themeChoice = stored;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Sebastian Sierra - ir al inicio">
        <span class="brand-mark">SS</span>
        <span>
          <strong>Sebastian Sierra</strong>
          <small>Full Stack Developer</small>
        </span>
      </a>

      <nav class="desktop-nav" aria-label="Navegacion principal">
        <a href="#proyectos">Proyectos</a>
        <a href="#stack">Stack</a>
        <a href="#proceso">Proceso</a>
        <a href="#contacto">Contacto</a>
      </nav>

      <div class="header-actions">
        <div class="theme-switcher" aria-label="Tema visual">
          <button type="button" data-theme-option="light">Claro</button>
          <button type="button" data-theme-option="dark">Oscuro</button>
          <button type="button" data-theme-option="system">Auto</button>
        </div>
        <a class="ghost-link" href={profile.cv} download>CV</a>
      </div>
    </header>

    <main id="inicio">
      <section class="hero section-pad">
        <div class="hero-copy reveal">
          <p class="eyebrow">Disponible para equipos remotos, producto y frontend</p>
          <h1>Full Stack Developer con foco en interfaces modernas, sistemas escalables y productos que funcionan.</h1>
          <p class="hero-lede">{profile.intro}</p>
          <div class="hero-actions">
            <a class="button primary" href="#proyectos">Ver proyectos</a>
            <a class="button secondary" href={`mailto:${profile.email}`}>Contratarme</a>
            <a class="button quiet" href={profile.cv} download>Descargar CV</a>
          </div>
          <div class="signal-row" aria-label="Especialidades">
            <span>React</span>
            <span>Next.js</span>
            <span>TypeScript</span>
            <span>Java</span>
            <span>Astro</span>
          </div>
        </div>

        <aside class="hero-card reveal" aria-label="Perfil de Sebastian Sierra">
          <div class="portrait-frame">
            <img src={profile.photo} alt="Foto de Sebastian Sierra" loading="eager" />
          </div>
          <div class="availability">
            <span class="status-dot"></span>
            <span>Abierto a oportunidades</span>
          </div>
          <h2>{profile.title}</h2>
          <p>{profile.location} · Remoto · Frontend / Full Stack</p>
          <div class="profile-links">
            <a href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
            <a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
            <a href={`mailto:${profile.email}`}>Email</a>
          </div>
        </aside>
      </section>

      <section class="proof section-shell reveal" aria-label="Prueba rapida de valor">
        {proofPoints.map((point) => (
          <article class="proof-card">
            <strong>{point.value}</strong>
            <h2>{point.label}</h2>
            <p>{point.detail}</p>
          </article>
        ))}
      </section>

      <section class="section-pad split-section reveal" id="proyectos">
        <div>
          <p class="eyebrow">Proyectos destacados</p>
          <h2>Casos que muestran producto, tecnica y criterio visual.</h2>
        </div>
        <p>
          Cada proyecto esta presentado como mini case study: problema, solucion, rol, stack y evidencia. Las capturas
          definitivas quedan listas para reemplazar los mockups provisionales.
        </p>
      </section>

      <section class="filters section-shell reveal" aria-label="Filtrar proyectos">
        <button type="button" data-filter="all" class="active">Todos</button>
        <button type="button" data-filter="frontend">Frontend</button>
        <button type="button" data-filter="fullstack">Full Stack</button>
        <button type="button" data-filter="backend">Backend</button>
        <button type="button" data-filter="automation">Automatizacion</button>
      </section>

      <section class="projects-grid section-shell">
        {allProjects.map((project, index) => (
          <article class={`project-card reveal ${index < 5 ? "featured" : ""}`} data-category={project.category}>
            <div class={`project-visual ${project.visual.tone}`}>
              <div class="mock-window">
                <div class="mock-top">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
                <div class="mock-content">
                  <div>
                    <small>{project.visual.label}</small>
                    <strong>{project.visual.metric}</strong>
                  </div>
                  <div class="mock-bars" aria-hidden="true">
                    <i></i>
                    <i></i>
                    <i></i>
                  </div>
                </div>
              </div>
            </div>
            <div class="project-body">
              <p class="eyebrow">{project.eyebrow}</p>
              <div class="project-heading">
                <h3>{project.name}</h3>
                <span>{project.status}</span>
              </div>
              <p>{project.summary}</p>
              <dl class="case-study">
                <div>
                  <dt>Problema</dt>
                  <dd>{project.problem}</dd>
                </div>
                <div>
                  <dt>Solucion</dt>
                  <dd>{project.solution}</dd>
                </div>
              </dl>
              <div class="stack-tags">
                {project.stack.map((item) => (
                  <span>{item}</span>
                ))}
              </div>
              <footer class="project-footer">
                <span>{project.role}</span>
                <div>
                  {project.links?.demo && (
                    <a href={project.links.demo} target="_blank" rel="noreferrer">Demo</a>
                  )}
                  {project.links?.repo && (
                    <a href={project.links.repo} target="_blank" rel="noreferrer">Repo</a>
                  )}
                </div>
              </footer>
            </div>
          </article>
        ))}
      </section>

      <section class="section-pad stack-section reveal" id="stack">
        <div class="section-intro">
          <p class="eyebrow">Mapa de capacidades</p>
          <h2>Stack tecnico organizado por lo que un equipo necesita resolver.</h2>
          <p>
            No es una lista infinita de herramientas: es la forma en que conecto experiencia de usuario, backend,
            datos y entrega para construir productos mantenibles.
          </p>
        </div>
        <div class="stack-grid">
          {stackGroups.map((group) => (
            <article class="stack-card">
              <h3>{group.title}</h3>
              <div>
                {group.items.map((item) => (
                  <span>{item}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section-shell journey reveal">
        <div>
          <p class="eyebrow">Evidencia de experiencia</p>
          <h2>Trayectoria con mentalidad de producto.</h2>
        </div>
        <div class="timeline">
          {timeline.map((item, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <p>{item.detail}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section-pad services reveal">
        <div class="section-intro">
          <p class="eyebrow">Que puedo construir</p>
          <h2>Soluciones listas para candidatos, startups y equipos de producto.</h2>
        </div>
        <div class="service-grid">
          {services.map((service) => (
            <article>
              <span></span>
              <h3>{service}</h3>
            </article>
          ))}
        </div>
      </section>

      <section class="section-shell process reveal" id="proceso">
        <div>
          <p class="eyebrow">Proceso de trabajo</p>
          <h2>De una idea borrosa a una entrega clara.</h2>
        </div>
        <ol>
          {process.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </section>

      <section class="section-pad github-panel reveal">
        <div>
          <p class="eyebrow">GitHub y evidencia tecnica</p>
          <h2>Codigo publico, proyectos variados y aprendizaje constante.</h2>
          <p>
            El portafolio apunta a que un reclutador pueda entender rapido mi valor, y que un equipo tecnico encuentre
            repositorios y decisiones concretas para revisar.
          </p>
        </div>
        <a class="button secondary" href={profile.github} target="_blank" rel="noreferrer">Ver GitHub</a>
      </section>

      <section class="final-cta reveal" id="contacto">
        <p class="eyebrow">Disponible para colaborar</p>
        <h2>Buscas un desarrollador que convierta ideas en producto funcional?</h2>
        <p>
          Puedo ayudarte con frontend moderno, aplicaciones full stack, automatizacion y experiencias digitales que se
          sientan profesionales desde el primer uso.
        </p>
        <div class="hero-actions">
          <a class="button primary" href={`mailto:${profile.email}`}>Escribeme</a>
          <a class="button secondary" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
          <a class="button quiet" href={profile.cv} download>CV en PDF</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>© 2026 {profile.name}</span>
      <span>{profile.email}</span>
      <span>Construido con Astro + TypeScript + Tailwind</span>
    </footer>

    <script>
      const themeButtons = document.querySelectorAll<HTMLButtonElement>("[data-theme-option]");
      const media = window.matchMedia("(prefers-color-scheme: dark)");
      const applyTheme = (choice: string) => {
        const resolved = choice === "system" ? (media.matches ? "dark" : "light") : choice;
        document.documentElement.dataset.theme = resolved;
        document.documentElement.dataset.themeChoice = choice;
        localStorage.setItem("portfolio-theme", choice);
        themeButtons.forEach((button) => {
          button.classList.toggle("active", button.dataset.themeOption === choice);
        });
      };

      applyTheme(localStorage.getItem("portfolio-theme") || "system");
      themeButtons.forEach((button) => {
        button.addEventListener("click", () => applyTheme(button.dataset.themeOption || "system"));
      });
      media.addEventListener("change", () => {
        if ((localStorage.getItem("portfolio-theme") || "system") === "system") applyTheme("system");
      });

      const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
      const cards = document.querySelectorAll<HTMLElement>("[data-category]");
      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const filter = button.dataset.filter || "all";
          filterButtons.forEach((item) => item.classList.toggle("active", item === button));
          cards.forEach((card) => {
            const visible = filter === "all" || card.dataset.category === filter;
            card.classList.toggle("is-hidden", !visible);
          });
        });
      });

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!prefersReducedMotion) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
      } else {
        document.querySelectorAll(".reveal").forEach((element) => element.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
